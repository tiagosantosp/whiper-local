# Provider: "openai" ou "groq" (Groq é mais rápido e mais barato)
API_PROVIDER=groq
API_KEY=your_api_key_here

# Modelos Groq: whisper-large-v3-turbo, whisper-large-v3
# Modelos OpenAI: whisper-1
MODEL=whisper-large-v3-turbo

# Hotkey — qualquer combinação aceite pela lib `keyboard` (ex: f13, ctrl+shift+space)
HOTKEY=ctrl+shift+space

# Modo: ptt (segurar para gravar, largar para transcrever) | toggle (premir 1x iniciar, 1x parar)
HOTKEY_MODE=ptt

# Saída: paste (clipboard + Ctrl+V simulado) | clipboard_only (só copia)
OUTPUT_MODE=paste
